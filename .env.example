# ==============================================================================
# Application Configuration
# ==============================================================================
APP_ENV=development
APP_NAME=oryn
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=oryn
POSTGRES_PASSWORD=oryn_dev_secret
POSTGRES_DB=oryn_db
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://oryn:oryn_dev_secret@localhost:5432/oryn_db?sslmode=disable

# ==============================================================================
# Cache & Rate Limiting (Redis)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ADDR=localhost:6379

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=oryn_dev_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ==============================================================================
# Media Provider (TMDB API)
# ==============================================================================
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
OUTBOUND_PROXY_URL=

# ==============================================================================
# AI Provider (Cloudflare Workers AI)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
AI_MAIN_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_LIGHT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
AI_DAILY_NEURON_BUDGET=10000

# ==============================================================================
# Frontend Environment
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
